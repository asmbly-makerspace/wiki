# packer/php-security-floor.env
# Single source of truth for the minimum patched PHP version required per
# major.minor branch. Sourced by packer/scripts/01-php.sh.
#
# ALAS2023-2026-3302 (Important): CVE-2026-109618 / CVE-2026-109619 — OOM
# longjmp() leaves request memory uninitialized; stale/freed global state can
# be read or branched on by a subsequent request. Remote code execution.
# Fixed upstream in php8.3-8.3.36-1.amzn2023.0.1 (aarch64 + x86_64).
# https://alas.aws.amazon.com/AL2023/ALAS2023-2026-3302.html
PHP_SECURITY_FLOOR_8_3=8.3.36

